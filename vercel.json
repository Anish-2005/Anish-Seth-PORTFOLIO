{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.anishseth.xyz" }], "destination": "https://www.anishseth.in/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.anishseth.xyz" }], "destination": "https://www.anishseth.in/:path*", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "anishseth.xyz" }], "destination": "https://www.anishseth.in/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "anishseth.xyz" }], "destination": "https://www.anishseth.in/:path*", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "anishseth.vercel.app" }], "destination": "https://www.anishseth.in/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "anishseth.vercel.app" }], "destination": "https://www.anishseth.in/:path*", "permanent": true }
  ]
}
